# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored and must never be committed.

# --- Provider selection ---------------------------------------------------
# openai | anthropic. Leave blank to infer from whichever API key is set
# (OpenAI wins if both are). The CLI can override this per run.
LLM_PROVIDER=

# Retries for transient API failures (uses exponential backoff).
LLM_MAX_RETRIES=3

# Per-request timeout in seconds, applied to every LLM call.
LLM_TIMEOUT_SECONDS=60

# --- OpenAI ---------------------------------------------------------------
# Required when the provider is openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used for every pipeline stage. Recorded in each run's metadata.
OPENAI_MODEL=gpt-4o

# Low temperature keeps research runs comparable; raise it to study variance.
OPENAI_TEMPERATURE=0.2

# --- Anthropic ------------------------------------------------------------
# Required when the provider is anthropic. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for every pipeline stage. Recorded in each run's metadata.
ANTHROPIC_MODEL=claude-opus-5

# Output budget per call, which the Anthropic API requires. It covers reasoning
# as well as the response, so leave generous headroom.
ANTHROPIC_MAX_TOKENS=16000

# Reasoning depth: low | medium | high | xhigh | max. Current Claude models
# reject temperature, so this is the equivalent quality/cost dial.
ANTHROPIC_EFFORT=high

# --- Resume length budget -------------------------------------------------
# Checked deterministically before rendering, and used as the target for the
# condensation pass when a resume does not fit one page.
SUMMARY_MAX_CHARACTERS=300
BULLET_MAX_CHARACTERS=220

# Bullets per entry. The response schemas also enforce these counts, so change
# the matching constants in src/resumelab/models/ if you change them here.
EXPERIENCE_BULLET_COUNT=3
PROJECT_BULLET_COUNT=3

# --- Paths ----------------------------------------------------------------
# Immutable source profile. Never written to during generation.
# Create it with: cp data/candidate_profile.example.yaml data/candidate_profile.yaml
# Everything under data/ except the template is git-ignored, so your personal
# details stay off the remote.
CANDIDATE_PROFILE_PATH=data/candidate_profile.yaml

# Root for generated experiment runs (output/runs/<timestamp>_<slug>/).
OUTPUT_DIR=output

# --- Diagnostics ----------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
