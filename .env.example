# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored and must never be committed.

# --- LLM provider ---------------------------------------------------------
# Required. Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used for every pipeline stage. Recorded in each run's metadata.json.
OPENAI_MODEL=gpt-4o

# Low temperature keeps research runs comparable; raise it to study variance.
OPENAI_TEMPERATURE=0.2

# Retries for transient API failures (uses exponential backoff).
OPENAI_MAX_RETRIES=3

# --- Paths ----------------------------------------------------------------
# Immutable source profile. Never written to during generation.
CANDIDATE_PROFILE_PATH=data/candidate_profile.yaml

# Root for generated experiment runs (output/runs/<timestamp>_<slug>/).
OUTPUT_DIR=output

# --- Diagnostics ----------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
