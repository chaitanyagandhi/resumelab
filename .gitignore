# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Secrets / local environment ---
# The .env.example template is intentionally tracked; real .env files never are.
.env
.env.*
!.env.example

# --- Tooling caches & coverage ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Candidate data ---
# The populated profile contains personal contact details and work history. Only the
# unpopulated template is tracked; every other profile stays local.
data/*.yaml
data/*.yml
!data/candidate_profile.example.yaml

# --- Research output ---
# Generated experiment runs and PDFs are reproducible artifacts, not source.
# The directory itself is tracked via output/.gitkeep so the path always exists.
output/*
!output/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
